# ----------------------------------------------------------------------------
# AI Chat - Background Worker (Golang) environment
# Copy to .env for local development.
# ----------------------------------------------------------------------------

# development | production
APP_ENV=development

# Postgres connection (must point at the same DB the API uses).
DATABASE_URL=postgres://aichat:aichat@localhost:5432/aichat?sslmode=disable

# Redis connection string (must match the API's REDIS_URL).
REDIS_URL=redis://localhost:6379/0

# Generic worker queue (placeholder; broadcast queue is separate).
WORKER_QUEUE_KEY=aichat:jobs:default

# Broadcast worker queue — must match the API's BROADCAST_QUEUE_KEY.
BROADCAST_QUEUE_KEY=aichat:broadcast:queue

# Number of concurrent job-consuming goroutines.
WORKER_CONCURRENCY=4

# Max retries per broadcast message before marking it failed.
WORKER_MAX_ATTEMPTS=3

# Meta Graph API base URLs.
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
META_API_BASE_URL=https://graph.facebook.com/v20.0

# StarSender V3 send endpoint for broadcasts on StarSender channels. Must
# match the API's STARSENDER_API_URL.
STARSENDER_API_URL=https://api.starsender.online/api/send

# SSRF protection for tenant-supplied URLs (outbound webhooks such as
# broadcast.completed, OneSender instance URLs for broadcasts). Must match
# the API's WEBHOOK_ALLOW_PRIVATE_TARGETS. Defaults to true in development
# and false in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
