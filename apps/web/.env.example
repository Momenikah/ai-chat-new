# ----------------------------------------------------------------------------
# AI Chat - Frontend (Next.js) environment
# Copy to .env.local for local development.
# ----------------------------------------------------------------------------

# Base URL of the Golang API (include the /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket endpoint of the Golang realtime server.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Public app name shown in the UI.
NEXT_PUBLIC_APP_NAME=AI Chat
