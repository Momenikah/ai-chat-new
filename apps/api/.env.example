# ----------------------------------------------------------------------------
# AI Chat - Backend API (Golang) environment
# Copy to .env for local development.
# ----------------------------------------------------------------------------

# development | production
APP_ENV=development

# Port the HTTP server listens on.
PORT=8080

# Public base URL of the API (used for building media/file URLs).
BASE_URL=http://localhost:8080

# PostgreSQL connection string.
DATABASE_URL=postgres://aichat:aichat@localhost:5432/aichat?sslmode=disable

# Redis connection string (cache, queue, realtime pub/sub).
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — MUST be changed in production (use a long random value).
JWT_SECRET=dev-secret-change-me-in-production

# Token lifetimes (Go duration format: 15m, 24h, 168h, ...).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Secret used to derive the AES-256 key that encrypts channel credentials
# at rest. MUST be changed in production (use a long random value).
CHANNEL_ENCRYPTION_KEY=dev-channel-encryption-key-change-me

# When true (development default), every outbound inbox message is followed
# 1.5s later by a fake inbound reply broadcast over WebSocket so realtime
# can be exercised without real channel provider integration. Set to
# false in production. NOTE: only fires for non-WhatsApp channels — when a
# conversation lives on a WhatsApp channel, MessageService routes the send
# through the Meta WhatsApp Cloud API instead.
INBOX_DEMO_ECHO=true

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------
# Base URL of the Graph API (override only for staging / tests).
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# Verify token Meta sends back during webhook setup. Must match the value
# you enter in the Meta App Dashboard → WhatsApp → Configuration.
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify-token

# App Secret used to validate X-Hub-Signature-256 on incoming webhooks.
# Leave empty in development to disable signature verification.
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Instagram DM + Facebook Messenger (Meta Messenger Platform)
# ---------------------------------------------------------------------------
# Base URL of the Graph API (override only for staging / tests).
META_API_BASE_URL=https://graph.facebook.com/v20.0

# Verify tokens Meta sends back during webhook setup. Must match the values
# you enter in the Meta App Dashboard → Webhooks for Instagram + Page.
INSTAGRAM_VERIFY_TOKEN=dev-instagram-verify-token
MESSENGER_VERIFY_TOKEN=dev-messenger-verify-token

# Shared Meta App Secret (Settings → Basic) used to validate the HMAC on
# Instagram + Messenger webhook deliveries. Leave empty in development.
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Broadcast worker queue
# ---------------------------------------------------------------------------
# Redis list shared between the API (producer) and the worker (consumer).
BROADCAST_QUEUE_KEY=aichat:broadcast:queue

# ---------------------------------------------------------------------------
# AI chatbot + Knowledge base (Part 9)
# ---------------------------------------------------------------------------
# Provider: mock (default — deterministic, no network) | openai (real API).
# The mock provider keeps the app fully usable without an API key.
AI_PROVIDER=mock

# AI API key — server-side only, NEVER exposed to the frontend. Required
# when AI_PROVIDER=openai. Leaving this empty with AI_PROVIDER=openai
# falls back to the mock provider with a startup warning.
AI_API_KEY=

# OpenAI-compatible base URL. Override to point at Azure OpenAI, OpenRouter,
# or a local inference gateway speaking the OpenAI Chat Completions protocol.
AI_BASE_URL=https://api.openai.com/v1

# Default model used for chat completions when an agent doesn't override it.
AI_MODEL=gpt-4o-mini

# Default model used for embeddings (must match the dimension stored in
# knowledge_chunks). Changing the model after ingestion requires a re-index.
AI_EMBED_MODEL=text-embedding-3-small

# Max characters per knowledge chunk before embedding. ~800 is a good
# balance between context size and retrieval precision.
AI_CHUNK_SIZE=800

# ---------------------------------------------------------------------------
# Developer API + Webhooks (Part 10)
# ---------------------------------------------------------------------------
# Per-API-key rate limit (requests per minute), enforced in Redis with a
# fixed-window counter. Set to 0 to disable rate limiting.
API_RATE_LIMIT_PER_MINUTE=120

# Outbound webhook delivery pipeline. WEBHOOK_WORKERS controls concurrency;
# WEBHOOK_QUEUE_SIZE bounds the in-memory buffer before deliveries are
# dropped (with a log) under extreme backpressure.
WEBHOOK_WORKERS=4
WEBHOOK_QUEUE_SIZE=256

# ---------------------------------------------------------------------------
# Billing — Midtrans payment gateway (Part 11)
# ---------------------------------------------------------------------------
# Leave MIDTRANS_SERVER_KEY empty to run the PLACEHOLDER billing flow: plan
# changes "settle" instantly and produce a paid invoice with no real money.
# Set the server key + base URL to integrate the real Midtrans Snap API.
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=

# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Local VPS storage directory for uploaded media.
UPLOAD_DIR=./storage/uploads
